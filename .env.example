# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=RetailIQ API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# For Docker Compose (internal network):
DATABASE_URL=mysql+aiomysql://retailiq:retailiq@db:3306/retailiq
# For local development (if MySQL is running locally):
# DATABASE_URL=mysql+aiomysql://retailiq:retailiq@localhost:3306/retailiq

# ── Redis ──────────────────────────────────────────────────────────────────────
# For Docker Compose:
REDIS_URL=redis://redis:6379/0
# For local development:
# REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Keys (optional — app falls back gracefully) ────────────────────────────
OPENWEATHER_API_KEY=
HOLIDAY_API_KEY=

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
